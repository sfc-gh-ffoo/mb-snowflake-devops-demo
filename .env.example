# =============================================================================
# MAYBANK SNOWFLAKE DEVOPS DEMO
# Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Snowflake Connection
SNOWFLAKE_ACCOUNT=your_account.region.cloud
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=MAYBANK_DEMO_DEV_ANALYTICS
SNOWFLAKE_ROLE=ACCOUNTADMIN

# Deployment Configuration
ENVIRONMENT=dev
DRY_RUN=true

# Optional: Key Pair Authentication (recommended for production)
# SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/private_key.pem
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=your_passphrase

